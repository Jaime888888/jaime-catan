#!/bin/bash
#SBATCH --job-name=catan-test
#SBATCH --account=snazaria_1817
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --partition=debug
#SBATCH --nodelist=b11-09
#SBATCH --gres=gpu:a40:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00

set -euo pipefail

mkdir -p logs checkpoints-test

module purge
module load gcc/13.3.0
module load cuda/12.6.3

if ! command -v cargo >/dev/null 2>&1; then
    if [ -f "$HOME/.cargo/env" ]; then
        source "$HOME/.cargo/env"
    fi
fi

export CARGO_TERM_COLOR=never
export RUST_BACKTRACE=1

nvidia-smi

cargo build --release --features cuda --bin catan

srun ./target/release/catan --checkpoint-dir ./checkpoints-test "$@"
